# IP/host that every client uses to reach master + consumer BATC ports.
# Linux host-network demo on one machine: 127.0.0.1
# Multi-host lab: LAN IP of the Docker host (e.g. 192.168.1.50)
CUPIDMQ_HOST_IP=127.0.0.1

# First BATC port; replicas get BASE, BASE+1, … (flock allocator)
CUPIDMQ_DATA_PORT_BASE=9760

# Simulated handler time per batch item (Rust + Python docker consumers)
CUPIDMQ_PROCESS_MS_MIN=2
CUPIDMQ_PROCESS_MS_MAX=16

# Producer enqueue rate per replica (--rate)
CUPIDMQ_PRODUCER_RATE=120

# Payload body size per message (--payload-bytes); 102400 = 100KB
CUPIDMQ_PAYLOAD_BYTES=102400

# Scale (CLI): make docker-up  →  8 producers, 8× rust + 8× python consumers
