# CupidMQ master — matchmaker (single control TCP; BATC is producer→consumer direct)

# Bind/listen — control + metrics HTTP (0.0.0.0 = all interfaces)
host=0.0.0.0
control_port=9750
metrics_port=9752

# Optional — serve dashboard from disk (`cupidmq` release binary embeds UI; headless has no UI)
# dashboard_dir=/path/to/vite/dist

# BATC (data plane) is NOT on the master — each consumer listens on :9760+ and advertises via REG!

history_interval_ms=2000
history_cap=1800
